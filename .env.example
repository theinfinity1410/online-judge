# Database Configuration
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DIALECT=postgres

# Database SSL Configuration (Optional - provide EITHER content OR path variables)
# Option 1: Provide PEM content directly (use \n for newlines)
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
# DB_SSL_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
# DB_SSL_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# Option 2: Provide file paths (recommended for Docker/deployment)
# DB_SSL_CA_PATH=/path/to/server-ca.pem
# DB_SSL_KEY_PATH=/path/to/client-key.pem
# DB_SSL_CERT_PATH=/path/to/client-cert.pem

# Important SSL Notes:
# - All three SSL components (CA, Key, Cert) must be provided together
# - If ANY SSL variable is set, ALL THREE are required
# - Use content vars (DB_SSL_*) for inline PEM or path vars (DB_SSL_*_PATH) for files
# - NEVER commit private keys to version control
# - Generate new certificates after any exposure (see README for instructions)

# JWT Secret (generate a strong random key)
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration
PORT=3000
NODE_ENV=production

# Cookie Configuration (optional)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Redis Configuration (for Flask/Celery workers)
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_BACKEND_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Configuration (for Flask worker communication)
BACKEND_HOST=backend
BACKEND_PORT=3000
